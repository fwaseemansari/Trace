# --- Database (Supabase Postgres) ---
# Check backend/database/db.py for the exact connection params it expects
# (either a single DATABASE_URL, or separate DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD)
DATABASE_URL=postgresql://postgres:your_password@your_supabase_host:5432/postgres

# --- Auth ---
# Generate with: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
SECRET_KEY=replace_with_a_random_48_byte_base64_string

# --- Groq (LLM inference) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Gmail SMTP (verification / password reset emails) ---
# Use a Gmail App Password, not your regular password
# Requires 2-Step Verification enabled on the Google account
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
